          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(feedbackloop_llm_custo_usd_total{ambiente=~\"$ambiente\"}[$__range]))) / (sum(increase(feedbackloop_analises_total{ambiente=~\"$ambiente\"}[$__range]))) > 0",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "noValue": "sem dados",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.015
              },
              {
                "color": "red",
                "value": 0.03
              }
            ]
          },
