            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(feedbackloop_qualidade_fragmentacao_temas_sum{ambiente=~\"$ambiente\"}[$__range])) / sum(increase(feedbackloop_qualidade_fragmentacao_temas_count{ambiente=~\"$ambiente\"}[$__range]))",
