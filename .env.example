# ============================================================================
# MODELO do arquivo .env  —  copie para ".env" e preencha:  cp .env.example .env
#
#   * O ".env" real está no .gitignore e NUNCA deve ser commitado.
#   * Este arquivo (.env.example) é versionado e só pode ter PLACEHOLDERS.
#   * Em dev e prod as variáveis ficam no painel do Render, uma por serviço,
#     com chaves DIFERENTES em cada ambiente (ver docs/seguranca/).
#   * Todas as variáveis que o código lê estão listadas aqui (há um teste que
#     garante isso: tests/test_trio_sagrado.py).
# ============================================================================

# --- Provedor de IA (OBRIGATÓRIA) -------------------------------------------
# Crie em https://platform.openai.com/api-keys uma chave por ambiente.
OPENAI_API_KEY=sk-...

# Modelo de chat. Padrão: gpt-5.4-mini
# OPENAI_MODEL=gpt-5.4-mini

# Preço em US$ por 1 milhão de tokens, conforme a página de preços do provedor.
# Sem os dois, o app mostra tokens mas não calcula custo (aparece "n/d").
# LLM_PRECO_ENTRADA_USD_POR_MTOK=
# LLM_PRECO_SAIDA_USD_POR_MTOK=

# --- Ambiente e desempenho ---------------------------------------------------
# local | dev | prod. No Render o app deduz sozinho pelo nome do serviço.
# APP_ENV=local

# Chamadas ao provedor em paralelo (1 = sequencial, como era antes da Etapa 2).
# LLM_MAX_WORKERS=8
# Timeout (segundos) e tentativas extras em erro 429/5xx (backoff exponencial do SDK).
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=3

# --- Cache e retenção --------------------------------------------------------
# Guarda só hash do texto já mascarado + tema + sentimento, com validade (TTL).
# CACHE_HABILITADO=true
# CACHE_TTL_DIAS=30
# CACHE_DB_PATH=.cache/feedbackloop.sqlite3

# --- Observabilidade (OpenTelemetry -> Grafana Cloud) ------------------------
# Sem ENDPOINT o app funciona normalmente, só não exporta traces/métricas.
# Valores da sua stack em Grafana Cloud > Connections > OpenTelemetry.
# OTEL_SERVICE_NAME=feedbackloop
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<regiao>.grafana.net/otlp
# O valor é "Authorization=Basic <base64 de instanceId:token>" (com %20 no lugar do espaço).
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64>
# Intervalo de envio das métricas, em milissegundos.
# OTEL_METRIC_EXPORT_INTERVAL=15000

# Link do dashboard público (aparece na barra lateral do app).
# DASHBOARD_URL=
